NODE_ENV=development
PORT=3000
APP_ENDPOINT=http://localhost:3000
MONGO_URI=mongodb://consent-manager-mongodb:27017/consent-manager
MONGO_URI_TEST=mongodb://consent-manager-mongodb:27017/consent-manager-test
API_PREFIX=/v1
SALT_ROUNDs=10
PDI_ENDPOINT=http://localhost:3331

APPLICATION_NAME=consentmanager-pdi
FEDERATED_APPLICATION_IDENTIFIER=http://localhost:3000

SESSION_COOKIE_NAME=consentmanagersessid
SESSION_SECRET=secret123
JWT_SECRET_KEY=secret123

OAUTH_SECRET_KEY=abc123secret
OAUTH_TOKEN_EXPIRES_IN=1h

CONTRACT_SERVICE_BASE_URL=http://localhost:3000/contracts

# Logs
WINSTON_LOGS_MAX_FILES=14d
WINSTON_LOGS_MAX_SIZE=20m

# Nodemailer
NODEMAILER_HOST=
NODEMAILER_PORT=
NODEMAILER_USER=abc@domain.com
NODEMAILER_PASS=pass
NODEMAILER_FROM_NOREPLY="abc <abc@domain.com>"

#MANDRILL
MANDRILL_ENABLED=false
MANDRILL_API_KEY="yourkey"
MANDRILL_FROM_EMAIL="noreply@visionstrust.com"
MANDRILL_FROM_NAME="noreply"

#Consent
#add multiple by adding ","
PRIVACY_RIGHTS=

WITHDRAWAL_METHOD=
CODE_OF_CONDUCT=
IMPACT_ASSESSMENT=
AUTHORITY_PARTY=

# Visonstrust
X_CATALOG_CONSENT_KEY=

# External IDP / OID4VP JWT verification (OIDC discovery + JWKS)
# Leave EXTERNAL_OIDC_ISSUERS empty to disable the feature entirely; every token
# then takes the existing local HMAC verification path unchanged.
# Comma-separated list of trusted issuer URLs, https only (must match the token
# `iss` claim).
EXTERNAL_OIDC_ISSUERS=
# Expected `aud` claim. Required whenever EXTERNAL_OIDC_ISSUERS is set.
EXTERNAL_OIDC_AUDIENCE=
# Allowed signing algorithms. Asymmetric only; anything else is rejected at
# startup. Defaults to RS256,ES256,EdDSA.
EXTERNAL_OIDC_ALGS=RS256,ES256,EdDSA
# Claim holding the value matched against User.email / Participant.did. Defaults
# to sub. When set to `email`, the token must also carry `email_verified: true`.
EXTERNAL_OIDC_SUBJECT_CLAIM=sub
# Discovery document and JWKS cache lifetime in seconds. Defaults to 3600.
EXTERNAL_OIDC_DISCOVERY_TTL=3600
# Path appended to each issuer URL to fetch its discovery document. Defaults to
# /.well-known/openid-configuration; override for issuers that serve it under a
# per-service path (e.g. FIWARE VCVerifier).
EXTERNAL_OIDC_DISCOVERY_PATH=/.well-known/openid-configuration
# Timeout for discovery and JWKS requests in milliseconds. Defaults to 5000.
EXTERNAL_OIDC_HTTP_TIMEOUT=5000
# Leeway on exp/nbf in seconds, absorbing clock skew. Defaults to 30.
EXTERNAL_OIDC_CLOCK_TOLERANCE=30
